{
    "name": "statamic-addon/visual-editor",
    "autoload": {
        "psr-4": {
            "MarioHamann\\StatamicVisualEditor\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MarioHamann\\StatamicVisualEditor\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^6.0",
        "spatie/browsershot": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.3",
        "larastan/larastan": "^3.15",
        "shipmonk/dead-code-detector": "^1.4",
        "rector/rector": "^2.8",
        "laravel/pint": "^1.32"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        },
        "statamic": {
            "name": "Statamic Visual Editor",
            "description": "Statamic Visual Editor addon"
        },
        "laravel": {
            "providers": [
                "MarioHamann\\StatamicVisualEditor\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "proprietary",
    "scripts": {
        "quality": "node scripts/quality.mjs php"
    },
    "scripts-descriptions": {
        "quality": "PHPStan, Pint and Rector against the baselines (quality pass)"
    }
}
